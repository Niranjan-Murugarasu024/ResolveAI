PROJECT_NAME=ResolveAI
VERSION=1.0.0
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./resolveai.db

# Provider Selection: openrouter | nvidia | groq | gemini | mock
LLM_PROVIDER=openrouter

# LLM Providers
OPENROUTER_API_KEY=sk-or-v1-your-key-here
NVIDIA_API_KEY=nvapi-your-key-here
GROQ_API_KEY=gsk_your-key-here
GEMINI_API_KEY=AIzaSy-your-key-here

# Default Models
DEFAULT_MODEL=openai/gpt-4o-mini
NVIDIA_MODEL=moonshotai/kimi-k3
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
FALLBACK_MODEL=google/gemini-2.5-flash

# Decision Engine Thresholds
RESOLVE_THRESHOLD=0.90
REVIEW_THRESHOLD=0.70

# Agent Guardrails & Stop Conditions
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=6
MAX_EXECUTION_SECONDS=30.0
MAX_COST_PER_TICKET_USD=0.05
